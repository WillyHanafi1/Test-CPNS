{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --import tsx --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "lint:participant": "eslint src/app src/components/AppShell.tsx src/components/HomeExamPreview.tsx src/components/HomeTrustStrip.tsx src/components/Modal.tsx src/components/PackageCard.tsx src/context/AuthContext.tsx src/features src/store/useExamStore.ts src/lib/api.ts src/lib/contact.ts src/lib/home-stats.ts src/lib/useResource.ts --ignore-pattern **/admin/** src/components/ThemeToggle.tsx src/context/ThemeContext.tsx src/lib/theme.ts src/components/DonationModal.tsx src/components/donations src/lib/donations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-oauth/google": "^0.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "katex": "0.19.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "katex": "$katex"
  }
}
